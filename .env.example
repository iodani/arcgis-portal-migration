# ArcGIS Online / Portal origen
ORIGEN_URL=https://your-org.maps.arcgis.com/
ORIGEN_USER=your_origin_user
ORIGEN_PASS=your_origin_password

# ArcGIS Portal destino
DESTINO_URL=https://www.arcgis.com
DESTINO_USER=your_dest_user
DESTINO_PASS=your_dest_password

# BASE DE DATOS (opcional) - correlacion con app.arcgis_upload
# Solo requerido por scripts/validate_db_correlation.py y
# scripts/generate_db_update.py cuando se usan con --db-dsn.
# No es necesario para el flujo principal de migracion.
# PGDSN acepta formato URI o keyword/value (lo que entienda psycopg2.connect()):
#   PGDSN=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
#   PGDSN=host=<db_host> port=5432 dbname=<db_name> user=<db_user> password=<db_password>
PGDSN=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
PGSCHEMA=app
